TMDB_API_KEY=your_tmdb_bearer_token
PORT=8080
CORS_ORIGINS=
# Required: signs the access tokens (generate with: openssl rand -base64 32)
JWT_SECRET=change_me

# Docker Compose - PostgreSQL
POSTGRES_USER=moovie
POSTGRES_PASSWORD=your_password
POSTGRES_DB=moovie
DB_PORT=5433
DATABASE_URL=postgresql://moovie:your_password@localhost:5433/moovie

# Sign in with Apple / Google (comma-separated client ids; each provider is off without them)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Revokes the Apple token when an account that signs in with Apple is deleted (App Store rule)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional: Slack or Discord webhook that gets each user report
REPORTS_WEBHOOK_URL=
